---
import Base from '@/layouts/Base.astro'
---
 
<Base title="Página no encontrada">
  <div class="min-h-screen bg-slate-50 flex items-center justify-center px-4">
    <div class="text-center max-w-sm">
      <p class="text-8xl font-bold text-slate-200 mb-4">404</p>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">Página no encontrada</h1>
      <p class="text-slate-500 mb-8">La página que buscás no existe o fue movida.</p>
      <div class="flex gap-3 justify-center">
        <a href="/restaurantos/dashboard" class="btn-primary">Ir al dashboard</a>
        <a href="/" class="btn-secondary">Inicio</a>
      </div>
    </div>
  </div>
</Base>
 