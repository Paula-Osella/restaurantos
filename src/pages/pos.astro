              />
            </div>
            <div class="flex justify-between text-base font-bold text-slate-900 pt-1 border-t border-slate-100">
              <span>Total</span>
              <span id="total-display">$0,00</span>
            </div>
          </div>

          <!-- Opciones -->
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="text-xs text-slate-500 mb-1 block">Mesa / Nro.</label>
              <input id="table-input" type="text" placeholder="Ej: 5" class="input text-sm py-1.5" />
            </div>
            <div>
              <label class="text-xs text-slate-500 mb-1 block">Pago</label>
              <select id="payment-method" class="input text-sm py-1.5">
                <option value="cash">Efectivo</option>
                <option value="card">Tarjeta</option>
                <option value="transfer">Transferencia</option>
                <option value="other">Otro</option>
              </select>
            </div>
          </div>

          <div>
            <label class="text-xs text-slate-500 mb-1 block">Notas del pedido</label>
            <input id="notes-input" type="text" placeholder="Ej: sin cebolla, salsa aparte…" class="input text-sm py-1.5" />
          </div>

          <div id="order-error" class="hidden text-xs text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></div>

          <button
            id="submit-order"
            disabled
            class="btn-primary w-full py-3 text-base disabled:opacity-40 disabled:pointer-events-none"
          >
            Confirmar pedido
          </button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script define:vars={{ currency }}>
  // ─── Estado del carrito ───────────────────────────────────────────────────
  let cart = []

  const fmt = (n) => new Intl.NumberFormat('es-AR', { style: 'currency', currency }).format(n)

  function getDiscount() {
    return parseFloat(document.getElementById('discount-input').value) || 0
  }

  function calcTotal() {
    const sub = cart.reduce((s, i) => s + i.price * i.qty, 0)
    const disc = getDiscount()
    return { subtotal: sub, total: Math.max(0, sub - disc) }
  }

  function renderCart() {
    const container = document.getElementById('cart-items')
    const empty = document.getElementById('cart-empty')
    const submitBtn = document.getElementById('submit-order')
    const { subtotal, total } = calcTotal()

    document.getElementById('subtotal-display').textContent = fmt(subtotal)
    document.getElementById('total-display').textContent = fmt(total)

    if (cart.length === 0) {
      empty.classList.remove('hidden')
      submitBtn.disabled = true
      // Clear all item elements
      container.querySelectorAll('.cart-item').forEach(el => el.remove())
      return
    }

    empty.classList.add('hidden')
    submitBtn.disabled = false

    // Remove old items and re-render
    container.querySelectorAll('.cart-item').forEach(el => el.remove())

    cart.forEach((item, idx) => {
      const div = document.createElement('div')
      div.className = 'cart-item flex items-center gap-3 py-2 border-b border-slate-100 last:border-0'
      div.innerHTML = `
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-slate-800 truncate">${item.name}</p>
          <p class="text-xs text-slate-500">${fmt(item.price)} c/u</p>
        </div>
        <div class="flex items-center gap-1.5">
          <button class="qty-btn w-6 h-6 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-sm flex items-center justify-center transition-colors" data-idx="${idx}" data-op="dec">−</button>
          <span class="w-6 text-center text-sm font-semibold text-slate-900">${item.qty}</span>
          <button class="qty-btn w-6 h-6 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-sm flex items-center justify-center transition-colors" data-idx="${idx}" data-op="inc">+</button>
        </div>
        <span class="text-sm font-bold text-slate-900 w-16 text-right">${fmt(item.price * item.qty)}</span>
      `
      container.appendChild(div)
    })

    container.querySelectorAll('.qty-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.idx)
        const op = btn.dataset.op
        if (op === 'inc') {
          cart[idx].qty++
        } else {
          cart[idx].qty--
          if (cart[idx].qty <= 0) cart.splice(idx, 1)
        }
        renderCart()
      })
    })
  }

  // ─── Agregar producto al carrito ──────────────────────────────────────────
  document.querySelectorAll('.product-card').forEach(card => {
    card.addEventListener('click', () => {
      const id = card.dataset.id
      const existing = cart.find(i => i.id === id)
      if (existing) {
        existing.qty++
      } else {
        cart.push({ id, name: card.dataset.name, price: parseFloat(card.dataset.price), qty: 1 })
      }
      renderCart()

      // Visual feedback
      card.classList.add('border-violet-400', 'bg-violet-50')
      setTimeout(() => card.classList.remove('border-violet-400', 'bg-violet-50'), 300)
    })
  })

  // ─── Limpiar carrito ──────────────────────────────────────────────────────
  document.getElementById('clear-cart').addEventListener('click', () => {
    cart = []
    renderCart()
  })

  // ─── Descuento ────────────────────────────────────────────────────────────
  document.getElementById('discount-input').addEventListener('input', renderCart)

  // ─── Filtro por categoría ─────────────────────────────────────────────────
  document.querySelectorAll('.category-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.category-tab').forEach(t => {
        t.classList.remove('active', 'bg-violet-600', 'text-white')
        t.classList.add('bg-slate-100', 'text-slate-600')
      })
      tab.classList.add('active', 'bg-violet-600', 'text-white')
      tab.classList.remove('bg-slate-100', 'text-slate-600')

      const catId = tab.dataset.category
      document.querySelectorAll('.product-card').forEach(card => {
        if (catId === 'all' || card.dataset.category === catId) {
          card.style.display = ''
        } else {
          card.style.display = 'none'
        }
      })
    })
  })

  // ─── Búsqueda de productos ────────────────────────────────────────────────
  document.getElementById('product-search').addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase()
    document.querySelectorAll('.product-card').forEach(card => {
      card.style.display = card.dataset.name.toLowerCase().includes(q) ? '' : 'none'
    })
  })

  // ─── Confirmar pedido ─────────────────────────────────────────────────────
  document.getElementById('submit-order').addEventListener('click', async () => {
    const submitBtn = document.getElementById('submit-order')
    const errorDiv = document.getElementById('order-error')
    errorDiv.classList.add('hidden')

    if (cart.length === 0) return

    submitBtn.disabled = true
    submitBtn.textContent = 'Procesando…'

    const { subtotal, total } = calcTotal()
    const discount = getDiscount()

    const payload = {
      items: cart.map(i => ({
        product_id: i.id,
        quantity: i.qty,
        unit_price: i.price,
      })),
      discount,
      total,
      subtotal,
      table_number: document.getElementById('table-input').value || null,
      payment_method: document.getElementById('payment-method').value,
      notes: document.getElementById('notes-input').value || null,
    }

    try {
      const res = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const data = await res.json()

      if (!data.success) {
        errorDiv.textContent = data.error ?? 'Error al crear el pedido.'
        errorDiv.classList.remove('hidden')
        return
      }

      // Éxito: limpiar todo
      cart = []
      document.getElementById('table-input').value = ''
      document.getElementById('notes-input').value = ''
      document.getElementById('discount-input').value = ''
      renderCart()

      // Toast de éxito
      const toast = document.createElement('div')
      toast.className = 'fixed top-4 right-4 z-50 bg-emerald-600 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg animate-fade-in flex items-center gap-2'
      toast.innerHTML = '✅ Pedido #' + data.data.id.slice(-6).toUpperCase() + ' creado'
      document.body.appendChild(toast)
      setTimeout(() => toast.remove(), 3000)
    } catch {
      errorDiv.textContent = 'Error de conexión. Intentá de nuevo.'
      errorDiv.classList.remove('hidden')
    } finally {
      submitBtn.disabled = false
      submitBtn.textContent = 'Confirmar pedido'
    }
  })
</script>
