---
import Base from '@/layouts/Base.astro'

const { businessId, supabase, userRole } = Astro.locals

// Cargar productos y categorías para el POS
const [{ data: categories }, { data: products }, { data: business }] = await Promise.all([
  supabase.from('categories').select('*').eq('business_id', businessId).eq('is_active', true).order('sort_order'),
  supabase.from('products').select('*, categories(id, name, color)').eq('business_id', businessId).eq('is_available', true).order('name'),
  supabase.from('businesses').select('currency').eq('id', businessId).single(),
])

const currency = business?.currency ?? 'ARS'
---

