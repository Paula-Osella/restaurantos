---
import Base from '@/layouts/Base.astro'

const plans = [
  {
    name: 'Gratis',
    price: 0,
    priceDisplay: 'Gratis',
    period: 'para siempre',
    description: 'Para probar sin compromiso.',
    featured: false,
    badge: null,
    cta: 'Empezar gratis',
    href: '/register',
    features: [
      { text: 'Hasta 10 productos',          ok: true  },
      { text: '1 empleado',                   ok: true  },
      { text: '1 sucursal',                   ok: true  },
      { text: 'POS básico',                   ok: true  },
      { text: 'Pantalla de cocina',           ok: true  },
      { text: 'Reportes',                     ok: false },
      { text: 'Inventario',                   ok: false },
      { text: 'Múltiples sucursales',         ok: false },
      { text: 'Soporte prioritario',          ok: false },
    ],
  },
  {
    name: 'Básico',
    price: 1000,
    priceDisplay: '$1.000',
    period: '/mes',
    description: 'Para emprendimientos pequeños.',
    featured: false,
    badge: null,
    cta: 'Suscribirse ahora',
    href: '/checkout',
    features: [
      { text: 'Hasta 50 productos',           ok: true  },
      { text: 'Hasta 2 empleados',            ok: true  },
      { text: '1 sucursal',                   ok: true  },
      { text: 'POS completo',                 ok: true  },
      { text: 'Pantalla de cocina',           ok: true  },
      { text: 'Reportes básicos',             ok: true  },
      { text: 'Inventario',                   ok: false },
      { text: 'Múltiples sucursales',         ok: false },
      { text: 'Soporte prioritario',          ok: false },
    ],
  },
  {
    name: 'Profesional',
    price: 2000,
    priceDisplay: '$2.000',
    period: '/mes',
    description: 'Para negocios en crecimiento.',
    featured: true,
    badge: 'Más popular',
    cta: 'Suscribirse ahora',
    href: '/checkout',
    features: [
      { text: 'Productos ilimitados',         ok: true  },
      { text: 'Hasta 10 empleados',           ok: true  },
      { text: 'Hasta 3 sucursales',           ok: true  },
      { text: 'POS completo',                 ok: true  },
      { text: 'Pantalla de cocina',           ok: true  },
      { text: 'Reportes avanzados',           ok: true  },
      { text: 'Inventario completo',          ok: true  },
      { text: 'Alertas de stock',             ok: true  },
      { text: 'Soporte prioritario',          ok: false },
    ],
  },
  {
    name: 'Premium',
    price: 3000,
    priceDisplay: '$3.000',
    period: '/mes',
    description: 'Para cadenas y franquicias.',
    featured: false,
    badge: null,
    cta: 'Suscribirse ahora',
    href: '/checkout',
    features: [
      { text: 'Productos ilimitados',         ok: true  },
      { text: 'Empleados ilimitados',         ok: true  },
      { text: 'Sucursales ilimitadas',        ok: true  },
      { text: 'POS completo',                 ok: true  },
      { text: 'Pantalla de cocina',           ok: true  },
      { text: 'Estadísticas avanzadas',       ok: true  },
      { text: 'Inventario completo',          ok: true  },
      { text: 'Acceso a API',                 ok: true  },
      { text: 'Soporte prioritario 24/7',     ok: true  },
    ],
  },
]

const features = [
  {
    icon: '🖥️',
    title: 'Punto de Venta (POS)',
    desc: 'Tomá pedidos al instante desde cualquier dispositivo. Gestión de mesas, delivery, para llevar y búsqueda de productos en tiempo real.',
  },
  {
    icon: '🍳',
    title: 'Pantalla de cocina',
    desc: 'La cocina ve los pedidos en el momento que se confirman. Actualizá el estado de cada orden con un toque.',
  },
  {
    icon: '📦',
    title: 'Inventario inteligente',
    desc: 'Controlá el stock de tus ingredientes y productos. Alertas automáticas cuando el nivel es bajo.',
  },
  {
    icon: '📊',
    title: 'Reportes y ventas',
    desc: 'Ventas por día, producto, empleado y sucursal. Exportá en CSV para tu contador.',
  },
  {
    icon: '👥',
    title: 'Gestión de empleados',
    desc: 'Roles diferenciados: admin, cajero, cocinero y empleado. Cada uno ve solo lo que necesita.',
  },
  {
    icon: '🏪',
    title: 'Multi-sucursal',
    desc: 'Gestioná todas tus sucursales desde un mismo panel. Reportes separados por cada local.',
  },
  {
    icon: '👤',
    title: 'Base de clientes',
    desc: 'Historial de pedidos y gasto por cliente. Ideal para programas de fidelización.',
  },
  {
    icon: '📱',
    title: 'Cobros con Mercado Pago',
    desc: 'Suscripciones mensuales o anuales con tarjeta de crédito, débito o saldo de MP.',
  },
]

const testimonials = [
  {
    name: 'Lucía M.',
    business: 'La Burguesía — Córdoba',
    text: 'Desde que usamos RestaurantOS los tiempos de atención bajaron un 40% y las confusiones de pedidos desaparecieron.',
  },
  {
    name: 'Marcos R.',
    business: 'Don Parrilla — Rosario',
    text: 'La pantalla de cocina fue un antes y un después. El equipo la adoptó en el primer día.',
  },
  {
    name: 'Valeria C.',
    business: 'Café Central — CABA',
    text: 'Tengo 3 sucursales y ahora puedo ver todo desde un solo lugar. Los reportes me salvaron la vida.',
  },
]
---

<Base title="RestaurantOS — Sistema de gestión para restaurantes">
  <div class="min-h-screen bg-slate-950 text-white">

    <!-- Nav -->
    <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-white/5">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-1.5 text-slate-500 hover:text-slate-300 text-xs transition-colors mr-2">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            SaaSAR
          </a>
          <div class="w-8 h-8 bg-violet-600 rounded-xl flex items-center justify-center text-base">🍔</div>
          <span class="font-bold text-white">RestaurantOS</span>
        </div>
        <div class="hidden md:flex items-center gap-6 text-sm text-slate-400">
          <a href="#funciones" class="hover:text-white transition-colors">Funciones</a>
          <a href="#planes"    class="hover:text-white transition-colors">Planes</a>
          <a href="/login"     class="hover:text-white transition-colors">Iniciar sesión</a>
        </div>
        <a href="/register" class="px-4 py-2 bg-violet-600 hover:bg-violet-500 text-white text-sm font-semibold rounded-xl transition-all active:scale-95 shadow-lg shadow-violet-900/40">
          Probar gratis
        </a>
      </nav>
    </header>

    <!-- Hero -->
    <section class="max-w-5xl mx-auto px-6 pt-24 pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-violet-500/10 border border-violet-500/20 rounded-full text-violet-300 text-xs font-medium mb-8">
        <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        Disponible ahora · Pagos con Mercado Pago
      </div>

      <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-6 leading-[1.08]">
        El sistema que tu
        <br />
        <span class="text-violet-400">restaurante siempre necesitó</span>
      </h1>

      <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        POS, cocina en tiempo real, inventario, reportes y cobros con
        <strong class="text-white font-medium">Mercado Pago</strong>.
        Gestión multi-sucursal y roles diferenciados para todo tu equipo.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
        <a href="/register"
          class="px-7 py-3.5 bg-violet-600 hover:bg-violet-500 text-white font-semibold rounded-xl transition-all active:scale-95 shadow-xl shadow-violet-900/40 text-base">
          Probar 14 días gratis
        </a>
        <a href="#planes"
          class="px-7 py-3.5 bg-white/8 hover:bg-white/12 text-white font-medium rounded-xl border border-white/10 transition-all text-base">
          Ver planes y precios
        </a>
      </div>
      <p class="text-xs text-slate-600">Sin tarjeta de crédito requerida · Cancelá cuando quieras</p>
    </section>

    <!-- Stats -->
    <section class="border-y border-white/5 bg-slate-900/40 py-10">
      <div class="max-w-4xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { n: '14 días',  label: 'de prueba gratuita'       },
          { n: '4 roles',  label: 'de usuario diferenciados' },
          { n: '5 módulos', label: 'integrados en uno'       },
          { n: '100% MP',  label: 'pagos con Mercado Pago'   },
        ].map(s => (
          <div>
            <p class="text-2xl font-bold text-white mb-1">{s.n}</p>
            <p class="text-xs text-slate-500">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features -->
    <section id="funciones" class="max-w-7xl mx-auto px-6 py-24">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-3">Todo lo que necesitás en un solo sistema</h2>
        <p class="text-slate-400 max-w-xl mx-auto">Sin apps separadas ni integraciones complicadas. Funciona desde el primer día.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map(f => (
          <div class="bg-slate-900 border border-white/8 rounded-2xl p-6 hover:border-violet-500/30 hover:bg-violet-500/5 transition-all group">
            <div class="text-3xl mb-4">{f.icon}</div>
            <h3 class="text-sm font-semibold text-white mb-2 group-hover:text-violet-300 transition-colors">{f.title}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Roles -->
    <section class="border-y border-white/5 bg-slate-900/40 py-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="text-2xl font-bold text-white mb-3">Un sistema, cuatro roles</h2>
          <p class="text-slate-400 text-sm">Cada persona ve exactamente lo que necesita para su trabajo.</p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            { emoji: '👔', role: 'Administrador',  color: 'violet', access: ['Dashboard completo', 'Reportes', 'Empleados', 'Configuración', 'Facturación'] },
            { emoji: '🛒', role: 'Cajero',          color: 'amber',  access: ['Punto de venta', 'Crear pedidos', 'Procesar pagos', 'Ver productos'] },
            { emoji: '🍳', role: 'Cocinero',        color: 'coral',  access: ['Pantalla de cocina', 'Ver cola de pedidos', 'Actualizar estado', 'Marcar listo'] },
            { emoji: '👷', role: 'Empleado',        color: 'teal',   access: ['Pedidos', 'Pantalla cocina', 'Inventario básico'] },
          ].map(r => (
            <div class={`bg-slate-900 border border-white/8 rounded-2xl p-5`}>
              <div class="text-2xl mb-3">{r.emoji}</div>
              <h3 class="text-sm font-bold text-white mb-3">{r.role}</h3>
              <ul class="space-y-1.5">
                {r.access.map(a => (
                  <li class="flex items-center gap-2 text-xs text-slate-400">
                    <svg class="w-3 h-3 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {a}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="max-w-5xl mx-auto px-6 py-20">
      <div class="text-center mb-12">
        <h2 class="text-2xl font-bold text-white mb-3">Lo que dicen nuestros clientes</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {testimonials.map(t => (
          <div class="bg-slate-900 border border-white/8 rounded-2xl p-6">
            <p class="text-sm text-slate-300 leading-relaxed mb-5 italic">"{t.text}"</p>
            <div class="border-t border-white/5 pt-4">
              <p class="text-xs font-semibold text-white">{t.name}</p>
              <p class="text-xs text-slate-500 mt-0.5">{t.business}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pricing -->
    <section id="planes" class="bg-slate-900/40 border-y border-white/5 py-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="text-center mb-14">
          <h2 class="text-3xl font-bold text-white mb-3">Planes para cada etapa de tu negocio</h2>
          <p class="text-slate-400 max-w-xl mx-auto">
            Todos los planes incluyen 14 días de prueba gratuita.
            Podés cambiar de plan en cualquier momento.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 items-stretch">
          {plans.map(plan => (
            <div class={`relative flex flex-col rounded-2xl border p-7 transition-all ${
              plan.featured
                ? 'bg-violet-600/10 border-violet-500 shadow-2xl shadow-violet-900/30'
                : 'bg-slate-900 border-white/10 hover:border-white/20'
            }`}>

              {plan.badge && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-10">
                  <span class="bg-violet-600 text-white text-xs font-bold px-4 py-1 rounded-full whitespace-nowrap">
                    {plan.badge}
                  </span>
                </div>
              )}

              <!-- Plan name + desc -->
              <div class="mb-5">
                <h3 class="text-base font-bold text-white mb-1">{plan.name}</h3>
                <p class="text-xs text-slate-500">{plan.description}</p>
              </div>

              <!-- Price -->
              <div class="mb-7">
                {plan.price === 0 ? (
                  <p class="text-4xl font-bold text-white">Gratis</p>
                ) : (
                  <div>
                    <div class="flex items-baseline gap-1">
                      <span class="text-3xl font-bold text-white">{plan.priceDisplay}</span>
                      <span class="text-slate-500 text-sm">{plan.period}</span>
                    </div>
                    <p class="text-xs text-emerald-400 mt-1.5">Plan anual: 2 meses gratis</p>
                  </div>
                )}
              </div>

              <!-- Features -->
              <ul class="space-y-2.5 flex-1 mb-8">
                {plan.features.map(f => (
                  <li class={`flex items-center gap-2.5 text-sm ${f.ok ? 'text-slate-200' : 'text-slate-600'}`}>
                    {f.ok ? (
                      <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    ) : (
                      <svg class="w-4 h-4 text-slate-700 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                      </svg>
                    )}
                    <span class={!f.ok ? 'line-through' : ''}>{f.text}</span>
                  </li>
                ))}
              </ul>

              <!-- CTA -->
              <a href={plan.href}
                class={`block text-center py-3 text-sm font-semibold rounded-xl transition-all active:scale-95 ${
                  plan.featured
                    ? 'bg-violet-600 hover:bg-violet-500 text-white shadow-lg shadow-violet-900/40'
                    : 'bg-white/8 hover:bg-white/12 text-white border border-white/10'
                }`}>
                {plan.cta}
              </a>
            </div>
          ))}
        </div>

        <!-- MP badge -->
        <div class="mt-10 flex items-center justify-center gap-3 text-sm text-slate-600">
          <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Pagos procesados de forma segura con
          <strong class="text-slate-400 font-semibold">Mercado Pago</strong>.
          Tarjeta de crédito, débito o saldo MP.
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto px-6 py-24">
      <h2 class="text-2xl font-bold text-white text-center mb-10">Preguntas frecuentes</h2>
      <div class="space-y-3">
        {[
          { q: '¿Necesito tarjeta para la prueba?',
            a: 'No. Los 14 días de prueba son completamente gratis y sin datos de pago. Solo se te solicitará cuando decidas suscribirte.' },
          { q: '¿Puedo cambiar de plan?',
            a: 'Sí, en cualquier momento desde la sección de Facturación. El cambio aplica de forma inmediata.' },
          { q: '¿Qué pasa si supero el límite de mi plan?',
            a: 'El sistema te avisa antes de llegar al límite y te propone actualizar. No se borra información existente.' },
          { q: '¿Funciona en celular y tablet?',
            a: 'Sí, el POS y la pantalla de cocina están optimizados para tablets. El dashboard es completamente responsive.' },
          { q: '¿Puedo tener varias sucursales?',
            a: 'Desde el plan Profesional podés agregar hasta 3 sucursales. El plan Premium no tiene límite de sucursales.' },
        ].map(item => (
          <details class="bg-slate-900 border border-white/8 rounded-2xl group">
            <summary class="px-6 py-4 text-sm font-medium text-white cursor-pointer list-none flex items-center justify-between hover:text-violet-300 transition-colors">
              {item.q}
              <svg class="w-4 h-4 text-slate-500 flex-shrink-0 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="px-6 pb-5 text-sm text-slate-400 leading-relaxed border-t border-white/5 pt-4">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Final CTA -->
    <section class="max-w-3xl mx-auto px-6 pb-28 text-center">
      <div class="bg-gradient-to-b from-violet-600/15 to-violet-900/5 border border-violet-500/20 rounded-3xl p-12">
        <p class="text-sm text-violet-400 font-medium mb-3">🍔 RestaurantOS</p>
        <h2 class="text-3xl font-bold text-white mb-4">¿Listo para modernizar tu restaurante?</h2>
        <p class="text-slate-400 mb-8 max-w-md mx-auto">
          Empezá gratis hoy. Sin tarjeta de crédito, sin compromisos.
        </p>
        <a href="/register"
          class="inline-block px-8 py-3.5 bg-violet-600 hover:bg-violet-500 text-white font-semibold rounded-xl transition-all active:scale-95 shadow-xl shadow-violet-900/40 text-base">
          Crear cuenta gratis →
        </a>
        <p class="text-xs text-slate-600 mt-4">14 días gratis · Cancelá cuando quieras · Mercado Pago</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-10">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-600">
        <div class="flex items-center gap-3">
          <span>RestaurantOS by <strong class="text-slate-500">SaaSAR</strong> · © <span id="year"></span></span>
        </div>
        <div class="flex gap-6">
          <a href="/"          class="hover:text-slate-400 transition-colors">← Todos los sistemas</a>
          <a href="#planes"    class="hover:text-slate-400 transition-colors">Planes</a>
          <a href="/login"     class="hover:text-slate-400 transition-colors">Iniciar sesión</a>
          <a href="/register"  class="hover:text-slate-400 transition-colors">Registrarse</a>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  html { scroll-behavior: smooth; }
  details summary::-webkit-details-marker { display: none; }
</style>

<script>
  document.getElementById('year').textContent = new Date().getFullYear().toString()
</script>
