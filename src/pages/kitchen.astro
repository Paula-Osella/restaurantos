---
import Base from '@/layouts/Base.astro'

const { businessId, supabase } = Astro.locals

const { data: activeOrders } = await supabase
  .from('orders')
  .select('*, order_items(*, products(name)), branches(name)')
  .eq('business_id', businessId)
  .in('status', ['confirmed', 'preparing'])
  .order('created_at', { ascending: true })
  .limit(30)

const PUBLIC_SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL
const PUBLIC_SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
---

<Base title="Cocina">
  <div class="min-h-screen bg-slate-900 text-white flex flex-col">

    <!-- Header -->
    <header class="h-14 bg-slate-800 border-b border-slate-700 flex items-center justify-between px-6 flex-shrink-0">
      <div class="flex items-center gap-3">
        <span class="text-lg font-bold">🍳 Pantalla de Cocina</span>
        <span class="w-2 h-2 bg-emerald-400 rounded-full pulse-dot"></span>
        <span id="order-count" class="text-xs bg-slate-700 text-slate-300 px-2 py-1 rounded-full">
          {(activeOrders ?? []).length} pedidos activos
        </span>
      </div>
      <div class="flex items-center gap-3 text-slate-400 text-sm">
        <span id="clock"></span>
        <a href="/restaurantos/dashboard" class="hover:text-white transition-colors text-sm">← Dashboard</a>
      </div>
    </header>

    <!-- Orders grid -->
    <div id="orders-container" class="flex-1 p-5 kds-grid overflow-y-auto">
      {(activeOrders ?? []).map(order => (
        <div
          class={`kitchen-card rounded-xl border-2 p-5 flex flex-col gap-4 animate-fade-in ${
            order.status === 'preparing'
              ? 'bg-amber-950/30 border-amber-500'
              : 'bg-slate-800 border-slate-600'
          }`}
          data-order-id={order.id}
          data-status={order.status}
        >
          <!-- Card header -->
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-lg font-bold">#{order.id.slice(-6).toUpperCase()}</span>
                {order.table_number && (
                  <span class="text-xs bg-slate-700 text-slate-300 px-2 py-0.5 rounded-full">
                    Mesa {order.table_number}
                  </span>
                )}
                {order.is_delivery && (
                  <span class="text-xs bg-blue-900 text-blue-300 px-2 py-0.5 rounded-full">🛵 Delivery</span>
                )}
              </div>
              <p class="text-xs text-slate-400 mt-1">
                {new Date(order.created_at).toLocaleTimeString('es-AR', { hour:'2-digit', minute:'2-digit' })}
              </p>
            </div>
            <span class={`text-xs font-bold px-2 py-1 rounded-lg ${
              order.status === 'preparing' ? 'bg-amber-500/20 text-amber-300' : 'bg-blue-500/20 text-blue-300'
            }`}>
              {order.status === 'preparing' ? '🔥 Preparando' : '📋 Nuevo'}
            </span>
          </div>

          <!-- Items -->
          <div class="space-y-2">
            {(order.order_items ?? []).map((item: any) => (
              <div class="flex items-start gap-3">
                <span class="text-xl font-bold text-white/80 w-7 flex-shrink-0 text-right">{item.quantity}×</span>
                <div>
                  <p class="font-semibold text-white text-sm">{item.products?.name ?? 'Producto'}</p>
                  {item.notes && <p class="text-xs text-amber-400 mt-0.5">⚠ {item.notes}</p>}
                </div>
              </div>
            ))}
          </div>

          {order.notes && (
            <div class="bg-amber-500/10 border border-amber-500/30 rounded-lg px-3 py-2">
              <p class="text-xs text-amber-300">📝 {order.notes}</p>
            </div>
          )}

          <!-- Actions -->
          <div class="flex gap-2 mt-auto pt-2">
            {order.status === 'confirmed' && (
              <button
                class="kitchen-action-btn flex-1 py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-bold text-sm rounded-xl transition-all active:scale-95"
                data-order-id={order.id}
                data-new-status="preparing"
              >
                🔥 Iniciar preparación
              </button>
            )}
            {order.status === 'preparing' && (
              <button
                class="kitchen-action-btn flex-1 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm rounded-xl transition-all active:scale-95"
                data-order-id={order.id}
                data-new-status="ready"
              >
                ✅ Listo para entregar
              </button>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Empty state -->
    {(activeOrders ?? []).length === 0 && (
      <div id="empty-state" class="flex-1 flex flex-col items-center justify-center text-slate-500">
        <span class="text-6xl mb-4">😴</span>
        <p class="text-lg font-medium">Sin pedidos activos</p>
        <p class="text-sm mt-1">Los nuevos pedidos aparecerán acá automáticamente</p>
      </div>
    )}
  </div>
</Base>

<script define:vars={{ businessId, PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY }}>
  // ─── Reloj ────────────────────────────────────────────────────────────────
  function updateClock() {
    document.getElementById('clock').textContent =
      new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
  }
  updateClock()
  setInterval(updateClock, 1000)

  // ─── Actualizar estado de pedido ──────────────────────────────────────────
  async function updateOrderStatus(orderId, newStatus) {
    const btn = document.querySelector(`[data-order-id="${orderId}"][data-new-status="${newStatus}"]`)
    if (btn) {
      btn.disabled = true
      btn.textContent = 'Actualizando…'
    }

    try {
      const res = await fetch(`/api/orders/${orderId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      })
      const data = await res.json()

      if (!data.success) {
        alert('Error al actualizar el pedido: ' + (data.error ?? 'Error desconocido'))
        if (btn) { btn.disabled = false; btn.textContent = 'Reintentar' }
        return
      }

      if (newStatus === 'ready') {
        // Remover la card del DOM con animación
        const card = document.querySelector(`.kitchen-card[data-order-id="${orderId}"]`)
        if (card) {
          card.style.opacity = '0'
          card.style.transform = 'scale(0.9)'
          card.style.transition = 'all 0.3s ease'
          setTimeout(() => card.remove(), 300)
        }
      }

    } catch {
      alert('Error de conexión.')
      if (btn) { btn.disabled = false }
    }
  }

  // ─── Event delegation para botones de acción ──────────────────────────────
  document.getElementById('orders-container').addEventListener('click', (e) => {
    const btn = e.target.closest('.kitchen-action-btn')
    if (!btn) return
    updateOrderStatus(btn.dataset.orderId, btn.dataset.newStatus)
  })

  // ─── Realtime con Supabase ────────────────────────────────────────────────
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'

  const supabase = createClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY)

  supabase
    .channel('kitchen-orders')
    .on('postgres_changes', {
      event: '*',
      schema: 'public',
      table: 'orders',
      filter: `business_id=eq.${businessId}`,
    }, async (payload) => {
      const order = payload.new

      if (payload.eventType === 'INSERT' || payload.eventType === 'UPDATE') {
        if (['confirmed', 'preparing'].includes(order.status)) {
          // Recargar la página para mostrar el nuevo pedido
          // En producción esto se podría hacer sin reload usando fetch
          location.reload()
        } else if (['ready', 'delivered', 'cancelled'].includes(order.status)) {
          // Remover card si existe
          const card = document.querySelector(`.kitchen-card[data-order-id="${order.id}"]`)
          if (card) {
            card.style.opacity = '0'
            card.style.transform = 'scale(0.9)'
            card.style.transition = 'all 0.3s ease'
            setTimeout(() => {
              card.remove()
              updateOrderCount()
            }, 300)
          }
        }
      }
    })
    .subscribe()

  function updateOrderCount() {
    const count = document.querySelectorAll('.kitchen-card').length
    const el = document.getElementById('order-count')
    if (el) el.textContent = `${count} pedidos activos`

    const empty = document.getElementById('empty-state')
    if (empty) {
      empty.style.display = count === 0 ? 'flex' : 'none'
    }
  }
</script>